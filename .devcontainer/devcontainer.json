{
  "name": "Mestra Nyx Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {},
  "remoteUser": "vscode",

  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--security-opt=seccomp=unconfined"
  ],

  // Montar Docker socket do host para usar docker/docker-compose
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,readonly,type=bind",
    "source=mestra-nyx-usersecrets,target=/home/vscode/.microsoft/usersecrets,type=volume"
  ],

  "remoteEnv": {
    "SSH_AUTH_SOCK": "/tmp/ssh-agent.sock",
    "DATABASE_HOST": "host.docker.internal",
    "REDIS_HOST": "host.docker.internal"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[csharp]": {
          "editor.defaultFormatter": "ms-dotnettools.csdevkit"
        }
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens",
        "humao.rest-client",
        "yzhang.markdown-all-in-one",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },

  "postCreateCommand": "dotnet --info && node --version && pnpm --version"
}
